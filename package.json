  "keywords": [
    "fps",
    "threejs",
    "socket.io",
    "multiplayer"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  }
